<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Set up your Profile"
            android:layout_marginTop="0dp"
            android:textColor="@color/black"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="STRIDE / MOBILE CAMPUS FITNESS"
            android:textColor="@color/garnet"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/profilePhotoButton"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_photo_circle"
            android:contentDescription="Upload profile photo"
            android:padding="35dp"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="Upload Profile Photo"
            android:textColor="@color/garnet"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="RUNNER BIO"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />



        <EditText
            android:id="@+id/bioInput"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top"
            android:hint="Tell the community about your running goals..."
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Select interests"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/marathonButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/bg_interest_unselected"
                android:text="Marathon"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/casualRunButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_interest_unselected"
                android:text="Casual Run"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/triathlonButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_interest_unselected"
                android:text="Triathlon"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/sprintButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/bg_interest_unselected"
                android:text="Sprint"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/trailRunsButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_interest_unselected"
                android:text="Trail Runs"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/intervalsButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_interest_unselected"
                android:text="Intervals"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary" />
        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Hardware sync"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/appleWatchSwitch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Apple Watch"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/ouraRingSwitch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Oura Ring"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/completeSetupButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_btn_garnet"
            android:text="+ Complete Setup"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>